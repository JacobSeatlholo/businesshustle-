// BusinessHustle Social Platform - Production Schema
// Real-time gamified economy with Discord integration
// NOTE: Monetary values stored as Int (cents) for precision

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USER & IDENTITY MODULE
// ============================================

model User {
  id                String   @id @default(cuid())
  discordId         String   @unique // Discord OAuth2 user ID
  email             String   @unique
  name              String?
  displayName       String?  // Custom display name (overrides Discord)
  avatarUrl         String?  // Discord avatar URL
  bannerUrl         String?  // Custom profile banner
  bio               String?  // Profile biography (max 500 chars)
  level             Int      @default(1) // Gamification level
  experiencePoints  Int      @default(0) // XP toward next level
  reputationScore   Int      @default(0) // Community reputation
  isOnline          Boolean  @default(false)
  lastSeenAt        DateTime @default(now())
  discordAccessToken  String? // Encrypted OAuth2 token
  discordRefreshToken String? // Encrypted refresh token
  tokenExpiresAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  wallet            Wallet?
  inventory         UserInventory[]
  sentTransactions  LedgerTransaction[] @relation("SenderTransactions")
  receivedTransactions LedgerTransaction[] @relation("ReceiverTransactions")
  roomMemberships    RoomMembership[]
  createdRooms      Room[] @relation("RoomCreator")
  giftSent          Gift[] @relation("GiftSender")
  giftReceived      Gift[] @relation("GiftReceiver")

  @@index([discordId])
  @@index([email])
  @@index([isOnline, lastSeenAt])
  @@map("users")
}

model Wallet {
  id                  String   @id @default(cuid())
  userId              String   @unique
  balance             Int      @default(0) // Stored in cents (100 = $1.00)
  totalEarned         Int      @default(0)
  totalSpent          Int      @default(0)
  currencyCode        String   @default("BHC") // BusinessHustle Credits
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallets")
}

// ============================================
// VIRTUAL SHOP MODULE
// ============================================

model ShopCategory {
  id          String      @id @default(cuid())
  name        String
  description String?
  icon        String?     // Emoji or icon identifier
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  items       ShopItem[]
  createdAt   DateTime    @default(now())

  @@index([isActive, sortOrder])
  @@map("shop_categories")
}

model ShopItem {
  id                String   @id @default(cuid())
  categoryId        String
  name              String
  description       String?
  itemType          ItemType // GIFT, BADGE, THEME, EMOJI, AVATAR_FRAME, EFFECT
  price             Int      @default(0) // Stored in cents
  currencyCode      String   @default("BHC")
  imageUrl          String?  // CDN URL for item artwork
  animationUrl      String?  // Lottie/JSON animation for gifts
  durationType      DurationType @default(PERMANENT) // PERMANENT, TEMPORARY, CONSUMABLE
  durationDays      Int?     // Validity period for temporary items
  maxOwnedPerUser   Int?     // NULL = unlimited
  isActive          Boolean  @default(true)
  isLimited         Boolean  @default(false) // Limited edition flag
  stockRemaining    Int?     // NULL = unlimited stock
  requiredLevel     Int      @default(1) // Minimum user level to purchase
  rarity            ItemRarity @default(COMMON)
  attributes        String?  // JSON metadata for item-specific config
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category ShopCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  inventoryItems UserInventory[]

  @@index([categoryId, isActive])
  @@index([itemType, isActive])
  @@index([price])
  @@map("shop_items")
}

enum ItemType {
  GIFT         // Sendable virtual gifts (roses, diamonds, etc.)
  BADGE        // Profile display badges
  THEME        // Chat room themes/skins
  EMOJI        // Custom animated emojis
  AVATAR_FRAME // Avatar border/decoration frames
  EFFECT       // Room-wide visual effects (confetti, etc.)
}

enum DurationType {
  PERMANENT   // Owns forever
  TEMPORARY   // Expires after durationDays
  CONSUMABLE  // Single-use (consumed on use)
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

// ============================================
// INVENTORY & OWNERSHIP MODULE
// ============================================

model UserInventory {
  id              String      @id @default(cuid())
  userId          String
  itemId          String
  quantity        Int         @default(1)
  isEquipped      Boolean     @default(false)
  equippedAt      DateTime?
  purchasedAt     DateTime    @default(now())
  expiresAt       DateTime?   // NULL for permanent items
  sourceType      InventorySource @default(PURCHASED) // PURCHASED, GIFTED, REWARDED, ACHIEVEMENT
  sourceReference String?     // Transaction ID or reward event ID
  isActive        Boolean     @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId]) // One inventory record per user-item pair
  @@index([userId, isActive])
  @@index([itemId])
  @@map("user_inventory")
}

enum InventorySource {
  PURCHASED  // Bought from shop
  GIFTED     // Received as gift
  REWARDED   // System reward (daily login, achievements)
  ACHIEVEMENT // Unlocked via milestones
}

// ============================================
// DOUBLE-ENTRY LEDGER (AUDIT READY)
// ============================================

model LedgerTransaction {
  id                  String           @id @default(cuid())
  transactionRef      String           @unique // Human-readable reference: TXN-YYYYMMDD-XXXXX
  senderWalletId      String?
  receiverWalletId    String?
  amount              Int              // Stored in cents
  currencyCode        String           @default("BHC")
  transactionType     TransactionType
  description         String?          // Human-readable description
  metadata            String?          // JSON for additional context
  status              TransactionStatus @default(COMPLETED)
  ipAddress           String?          // For fraud detection
  userAgent           String?
  completedAt         DateTime         @default(now())
  createdAt           DateTime         @default(now())

  sender      User?   @relation("SenderTransactions", fields: [senderWalletId], references: [id])
  receiver    User?   @relation("ReceiverTransactions", fields: [receiverWalletId], references: [id])

  ledgerEntries     LedgerEntry[] @relation("LedgerTransactionEntries")

  @@index([senderWalletId, completedAt])
  @@index([receiverWalletId, completedAt])
  @@index([transactionType, status, completedAt])
  @@index([transactionRef])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id              String       @id @default(cuid())
  transactionId   String
  walletId        String
  entryType       EntryType    // DEBIT or CREDIT
  amount          Int          // Stored in cents
  runningBalance  Int          // Balance AFTER this entry (in cents)
  createdAt       DateTime     @default(now())

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, name: "LedgerTransactionEntries")

  @@index([walletId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

enum TransactionType {
  PURCHASE       // Buying shop items
  GIFT_SEND      // Sending virtual gift to another user
  GIFT_RECEIVE   // Receiving virtual gift
  DAILY_BONUS    // Daily login reward
  LEVEL_UP       // Bonus for reaching new level
  REFUND         // Admin-initiated refund
  TOP_UP         // Purchasing credits (real money)
  SYSTEM_GRANT   // Admin/system credits
  SYSTEM_DEDUCT  // Admin/system deduction
  CASHOUT        // Converting to real currency (if applicable)
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
  CANCELLED
}

enum EntryType {
  DEBIT   // Money out (reduces balance)
  CREDIT  // Money in (increases balance)
}

// ============================================
// REAL-TIME ROOMS & SOCIAL MODULE
// ============================================

model Room {
  id                String   @id @default(cuid())
  name              String
  description       String?
  roomId            String   @unique // Discord channel ID this room bridges to
  type              RoomType @default(PUBLIC)
  maxMembers        Int      @default(100)
  currentMemberCount Int     @default(0)
  themeId           String?  // Equipped theme from inventory
  isActive          Boolean  @default(true)
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members       RoomMembership[]
  gifts         Gift[]
  creator       User @relation("RoomCreator", fields: [createdBy], references: [id])

  @@index([roomId]) // Discord channel lookup
  @@index([type, isActive])
  @@map("rooms")
}

enum RoomType {
  PUBLIC    // Anyone can join
  PRIVATE   // Invite only
  VIP       // Premium members only
  SYSTEM    // Official platform rooms
}

model RoomMembership {
  id            String   @id @default(cuid())
  userId        String
  roomId        String
  role          RoomRole @default(MEMBER)
  joinedAt      DateTime @default(now())
  lastActiveAt  DateTime @default(now())
  isMuted       Boolean  @default(false)
  muteUntil     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([roomId, role])
  @@index([userId, lastActiveAt])
  @@map("room_memberships")
}

enum RoomRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
  BANNED
}

// ============================================
// GIFTING & REAL-TIME EVENTS MODULE
// ============================================

model Gift {
  id              String       @id @default(cuid())
  giftItemId      String
  senderId        String
  receiverId      String
  roomId          String?      // Room where gift was sent (NULL = direct message)
  quantity        Int          @default(1)
  message         String?      // Personal note with gift (max 200 chars)
  isAnonymous     Boolean      @default(false)
  isPublic        Boolean      @default(true) // Show in room or private
  animationTriggered Boolean   @default(false) // Whether room animation played
  createdAt       DateTime     @default(now())

  sender    User @relation("GiftSender", fields: [senderId], references: [id])
  receiver  User @relation("GiftReceiver", fields: [receiverId], references: [id])
  room      Room? @relation(fields: [roomId], references: [id])

  @@index([receiverId, createdAt])
  @@index([roomId, createdAt])
  @@index([senderId, createdAt])
  @@map("gifts")
}

// ============================================
// SESSIONS & PRESENCE (for caching layer)
// ============================================

model ActiveSession {
  id              String   @id @default(cuid())
  userId          String
  socketId        String?  // Socket.io session ID
  roomId          String?  // Current active room
  deviceType      String?  // mobile, desktop, tablet
  ipAddress       String?
  lastHeartbeat   DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([socketId])
  @@index([roomId, lastHeartbeat])
  @@map("active_sessions")
}
